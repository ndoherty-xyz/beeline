{
  "name": "beeline-repo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build -w beeline-extension",
    "watch": "npm run watch -w beeline-extension",
    "playground": "esbuild packages/beeline/playground/playground.ts --bundle --outdir=packages/beeline/playground/dist --servedir=packages/beeline/playground --serve=localhost:8123",
    "typecheck": "tsc && tsc -p packages/beeline",
    "test": "node --test test/*.test.ts",
    "eval": "node eval/run.ts",
    "train": "uv run --project train train/train.py",
    "convert-adserp": "node eval/helpers/convert-adserp.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
